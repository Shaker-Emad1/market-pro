# ============================================================
# Market Pro POS — Environment Variables
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below.
# 3. NEVER commit the .env file (it is in .gitignore).
# ============================================================

# ---------------------------
# SQL Server
# ---------------------------
# Strong password required by SQL Server 2022:
#   - Min 8 characters
#   - Mix of uppercase, lowercase, digits, and symbols
SQL_SA_PASSWORD=Change_Me_Strong!Pass1

# ---------------------------
# JWT Authentication
# ---------------------------
# Minimum 32 characters, cryptographically random.
# Generate one: openssl rand -base64 48
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
